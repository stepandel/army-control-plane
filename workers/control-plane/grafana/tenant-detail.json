          "legendFormat": "size",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Volume size",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
      "description": "Concurrent requests on port 3000 (the app service).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 19, "y": 0 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
