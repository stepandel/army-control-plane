          "expr": "max(fly_volume_used_percent{app=\"$app\"})",
          "legendFormat": "volume %",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Volume used",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
      "description": "Current volume size.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "decbytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 14, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
