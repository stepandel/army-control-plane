      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
          "editorMode": "code",
          "expr": "sum(fly_app_concurrency_requests{app=\"$app\"})",
          "legendFormat": "concurrency",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Concurrent requests",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
      "description": "CPU utilization rate per core over the last 5 min.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "percentunit",
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
          "editorMode": "code",
          "expr": "rate(fly_instance_cpu_total{app=\"$app\"}[5m]) / fly_instance_cpu_count{app=\"$app\"}",
          "legendFormat": "{{ instance }}",
          "refId": "A"
        }
      ],
      "title": "CPU utilization",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
