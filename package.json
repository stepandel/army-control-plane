{
  "name": "army-control-pane",
  "private": true,
  "scripts": {
    "dev:router": "pnpm --filter @army/router dev",
    "dev:control-plane": "pnpm --filter @army/control-plane dev",
    "deploy:router": "pnpm -F @army/router run deploy",
    "deploy:control-plane": "pnpm -F @army/control-plane run deploy",
    "dev:website": "pnpm --filter @army/website dev",
    "build:website": "pnpm --filter @army/website build",
    "deploy:website": "pnpm --filter @army/website deploy",
    "typecheck": "tsc -b",
    "typecheck:website": "pnpm --filter @army/website exec astro check",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm typecheck:website && pnpm test"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "@biomejs/biome": "^2.4.10",
    "@cloudflare/vitest-pool-workers": "^0.14.1",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2",
    "wrangler": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "dbmate",
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
