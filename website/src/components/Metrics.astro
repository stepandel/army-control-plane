---
const stats = [
  {
    value: "5-stage",
    label: "lifecycle",
    description:
      "Research, Plan, Execute, Review, Triage — every task follows your team's workflow.",
  },
  {
    value: "0",
    label: "context switches",
    description:
      "Delegate via Slack DM, review the PR. Nothing in between.",
  },
  {
    value: "24/7",
    label: "async",
    description:
      "Vera works nights, weekends, and holidays. Your backlog doesn't wait.",
  },
];
---

<section id="metrics" class="metrics" aria-labelledby="metrics-heading">
  <div class="section-inner">
    <h2 id="metrics-heading">
      Engineers ship more when Vera works the backlog
    </h2>

    <div class="stats-grid">
      {
        stats.map((stat) => (
          <div class="stat">
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
            <p class="stat-desc">{stat.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .metrics {
    padding: 5rem 1.5rem;
    border-top: 1px solid rgba(232, 245, 238, 0.15);
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
    letter-spacing: -0.02em;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .stat {
    text-align: center;
    padding: 2.5rem 1.5rem;
    border: 1px solid rgba(232, 245, 238, 0.15);
    border-radius: 16px;
  }

  .stat-value {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 800;
    color: var(--color-text);
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .stat-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
