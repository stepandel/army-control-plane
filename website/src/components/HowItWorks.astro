---
import ResearchIcon from "./icons/ResearchIcon.astro";
import PrepIcon from "./icons/PrepIcon.astro";
import ExecuteIcon from "./icons/ExecuteIcon.astro";
import TriageIcon from "./icons/TriageIcon.astro";
const stages = [
  {
    iconComponent: "research",
    name: "Research",
    description:
      "Vera investigates the problem space: reads the codebase, searches documentation, analyzes competitor approaches, and gathers the context needed to make informed decisions.",
    screenshot: "/screenshot-research.png",
    screenshotAlt: "Vera researching a codebase in Linear with the #research label",
  },
  {
    iconComponent: "prep",
    name: "Prep & Plan",
    description:
      "Before writing a single line of code, Vera sizes the work, validates scope, identifies entry points, and creates a concrete implementation plan — just like a senior engineer would.",
    screenshot: "/screenshot-prep.png",
    screenshotAlt: "Vera creating an execution plan with sub-issues in Linear with the #prep label",
  },
  {
    iconComponent: "execute",
    name: "Execute",
    description:
      "Vera implements the solution: writes production code, follows existing patterns and conventions, adds tests, and opens a pull request with a clear description of what changed and why.",
    screenshot: "/screenshot-execute.png",
    screenshotAlt: "Vera completing a task lifecycle — from prep to PR opened in Linear",
  },
];
---

<section id="how-it-works" class="how-it-works" aria-labelledby="hiw-heading">
  <div class="section-inner">
    <h2 id="hiw-heading">From Slack message to merged PR — autonomously</h2>
    <p class="section-intro">
      Vera follows the same engineering workflow your team does. Every task moves
      through a three-stage lifecycle — no babysitting required.
    </p>

    <div class="stages">
      {
        stages.map((stage, i) => (
          <div class:list={["stage-row", { reverse: i % 2 === 1 }]}>
            <div class="stage-text">
              <div class="stage-icon">
                {stage.iconComponent === "research" && <ResearchIcon size={28} />}
                {stage.iconComponent === "prep" && <PrepIcon size={28} />}
                {stage.iconComponent === "execute" && <ExecuteIcon size={28} />}
              </div>
              <h3 class="stage-name">{stage.name}</h3>
              <p class="stage-desc">{stage.description}</p>
            </div>
            <div class="stage-screenshot">
              <img src={stage.screenshot} alt={stage.screenshotAlt} loading="lazy" />
            </div>
          </div>
        ))
      }

      <div class="stage-row">
        <div class="stage-text">
          <div class="stage-icon">
            <TriageIcon size={28} />
          </div>
          <h3 class="stage-name">Triage</h3>
          <p class="stage-desc">
            When bugs surface or tickets pile up, Vera investigates root causes,
            assesses impact, and either fixes issues directly or provides detailed
            analysis so your team can act fast.
          </p>
        </div>
        <div class="stage-screenshot">
          <img src="/screenshot-triage.png" alt="Vera triaging and fixing a bug with results shown in Linear and Slack" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .how-it-works {
    padding: 5rem 1.5rem;
    border-top: 1px solid rgba(13, 40, 24, 0.15);
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .section-intro {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 1.125rem;
    max-width: 640px;
    margin: 0 auto 3rem;
    line-height: 1.6;
  }

  .stages {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .stage-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .stage-row.reverse {
    direction: rtl;
  }

  .stage-row.reverse > * {
    direction: ltr;
  }

  .stage-text {
    display: flex;
    flex-direction: column;
  }

  .stage-icon {
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border: 1px solid rgba(13, 40, 24, 0.15);
    border-radius: 16px;
    color: var(--color-text);
  }

  .stage-name {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .stage-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .stage-screenshot {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(13, 40, 24, 0.15);
  }

  .stage-screenshot img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 768px) {
    .stage-row {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .stage-row.reverse {
      direction: ltr;
    }
  }
</style>
