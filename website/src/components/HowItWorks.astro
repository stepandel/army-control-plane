---
import ResearchIcon from "./icons/ResearchIcon.astro";
import PrepIcon from "./icons/PrepIcon.astro";
import ExecuteIcon from "./icons/ExecuteIcon.astro";
import TriageIcon from "./icons/TriageIcon.astro";
const stages = [
  {
    iconComponent: "research",
    name: "Research",
    description:
      "Vera investigates the problem space: reads the codebase, searches documentation, analyzes competitor approaches, and gathers the context needed to make informed decisions.",
    screenshot: "/screenshot-research.png",
    screenshotAlt: "Vera researching a codebase in Linear with the #research label",
  },
  {
    iconComponent: "prep",
    name: "Prep & Plan",
    description:
      "Before writing a single line of code, Vera sizes the work, validates scope, identifies entry points, and creates a concrete implementation plan — just like a senior engineer would.",
    screenshot: "/screenshot-prep.png",
    screenshotAlt: "Vera creating an execution plan with sub-issues in Linear with the #prep label",
  },
  {
    iconComponent: "execute",
    name: "Execute",
    description:
      "Vera implements the solution: writes production code, follows existing patterns and conventions, adds tests, and opens a pull request with a clear description of what changed and why.",
    screenshot: "/screenshot-execute.png",
    screenshotAlt: "Vera completing a task lifecycle — from prep to PR opened in Linear",
  },
  {
    iconComponent: "triage",
    name: "Triage",
    description:
      "When bugs surface or tickets pile up, Vera investigates root causes, assesses impact, and either fixes issues directly or provides detailed analysis so your team can act fast.",
    screenshot: "/screenshot-triage.png",
    screenshotAlt: "Vera triaging and fixing a bug with results shown in Linear and Slack",
  },
];
---

<section id="how-it-works" class="how-it-works" aria-labelledby="hiw-heading">
  <div class="section-inner">
    <h2 id="hiw-heading">From Slack message to merged PR — autonomously</h2>
    <p class="section-intro">
      Vera follows the same engineering workflow your team does. Every task moves
      through a structured lifecycle — no babysitting required.
    </p>

    <div class="carousel">
      <div class="carousel-tabs" role="tablist">
        {
          stages.map((stage, i) => (
            <button
              class:list={["carousel-tab", { active: i === 0 }]}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`panel-${i}`}
              data-index={i}
            >
              <span class="tab-icon">
                {stage.iconComponent === "research" && <ResearchIcon size={20} />}
                {stage.iconComponent === "prep" && <PrepIcon size={20} />}
                {stage.iconComponent === "execute" && <ExecuteIcon size={20} />}
                {stage.iconComponent === "triage" && <TriageIcon size={20} />}
              </span>
              <span class="tab-label">{stage.name}</span>
            </button>
          ))
        }
      </div>

      <div class="carousel-panels">
        {
          stages.map((stage, i) => (
            <div
              class:list={["carousel-panel", { active: i === 0 }]}
              role="tabpanel"
              id={`panel-${i}`}
              data-index={i}
            >
              <div class="panel-content">
                <p class="panel-desc">{stage.description}</p>
              </div>
              <div class="panel-screenshot">
                <img src={stage.screenshot} alt={stage.screenshotAlt} loading="lazy" />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".carousel-tab");
  const panels = document.querySelectorAll<HTMLDivElement>(".carousel-panel");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const index = tab.dataset.index;
      tabs.forEach((t) => {
        t.classList.remove("active");
        t.setAttribute("aria-selected", "false");
      });
      panels.forEach((p) => p.classList.remove("active"));
      tab.classList.add("active");
      tab.setAttribute("aria-selected", "true");
      document.getElementById(`panel-${index}`)?.classList.add("active");
    });
  });
</script>

<style>
  .how-it-works {
    padding: 5rem 1.5rem;
    border-top: 1px solid rgba(13, 40, 24, 0.15);
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .section-intro {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 1.125rem;
    max-width: 640px;
    margin: 0 auto 3rem;
    line-height: 1.6;
  }

  .carousel-tabs {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .carousel-tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    border: 1px solid rgba(13, 40, 24, 0.15);
    border-radius: 100px;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .carousel-tab:hover {
    border-color: var(--color-text);
  }

  .carousel-tab.active {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }

  .tab-icon {
    display: flex;
    align-items: center;
  }

  .carousel-panel {
    display: none;
    grid-template-columns: 1fr 1.5fr;
    gap: 2.5rem;
    align-items: center;
  }

  .carousel-panel.active {
    display: grid;
  }

  .panel-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .panel-screenshot {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(13, 40, 24, 0.15);
  }

  .panel-screenshot img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 768px) {
    .carousel-tabs {
      flex-wrap: wrap;
    }

    .carousel-tab {
      padding: 0.5rem 1rem;
      font-size: 0.8rem;
    }

    .tab-label {
      display: none;
    }

    .carousel-panel.active {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
  }
</style>
