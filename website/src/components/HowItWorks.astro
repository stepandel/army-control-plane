---
import ResearchIcon from "./icons/ResearchIcon.astro";
import PrepIcon from "./icons/PrepIcon.astro";
import ExecuteIcon from "./icons/ExecuteIcon.astro";
import TriageIcon from "./icons/TriageIcon.astro";
const stages = [
  {
    iconComponent: "research",
    name: "Research",
    label: "#research",
    description:
      "Vera investigates the problem space: reads the codebase, searches documentation, analyzes competitor approaches, and gathers the context needed to make informed decisions.",
    screenshot: "/screenshot-research.png",
    screenshotAlt: "Vera researching a codebase in Linear with the #research label",
  },
  {
    iconComponent: "prep",
    name: "Prep & Plan",
    label: "#prep",
    description:
      "Before writing a single line of code, Vera sizes the work, validates scope, identifies entry points, and creates a concrete implementation plan — just like a senior engineer would.",
    screenshot: "/screenshot-prep.png",
    screenshotAlt: "Vera creating an execution plan with sub-issues in Linear with the #prep label",
  },
  {
    iconComponent: "execute",
    name: "Execute",
    label: "#execute",
    description:
      "Vera implements the solution: writes production code, follows existing patterns and conventions, adds tests, and opens a pull request with a clear description of what changed and why.",
    screenshot: "/screenshot-execute.png",
    screenshotAlt: "Vera completing a task lifecycle — from prep to PR opened in Linear",
  },
  {
    iconComponent: "triage",
    name: "Triage",
    label: "#triage",
    description:
      "When bugs surface or tickets pile up, Vera investigates root causes, assesses impact, and either fixes issues directly or provides detailed analysis so your team can act fast.",
    screenshot: "/screenshot-triage.png",
    screenshotAlt: "Vera triaging and fixing a bug with results shown in Linear and Slack",
  },
];
---

<section id="how-it-works" class="how-it-works" aria-labelledby="hiw-heading">
  <div class="section-inner">
    <h2 id="hiw-heading">Label-driven execution modes</h2>
    <p class="section-intro">
      Vera ships with prebuilt Linear labels. Add one to a ticket and Vera
      switches execution mode — from deep research to full implementation.
    </p>

    <div class="book-wrapper"><div class="book" id="book">
      {
        stages.map((stage, i) => (
          <div
            class:list={["book-page", { active: i === 0 }]}
            data-index={i}
          >
            <div class="page-spine">
              <span class="spine-label">{stage.label}</span>
            </div>
            <div class="page-content">
              <div class="page-text">
                <div class="page-icon">
                  {stage.iconComponent === "research" && <ResearchIcon size={24} />}
                  {stage.iconComponent === "prep" && <PrepIcon size={24} />}
                  {stage.iconComponent === "execute" && <ExecuteIcon size={24} />}
                  {stage.iconComponent === "triage" && <TriageIcon size={24} />}
                </div>
                <span class="page-label">{stage.label}</span>
                <h3 class="page-name">{stage.name}</h3>
                <p class="page-desc">{stage.description}</p>
              </div>
              <div class="page-screenshot">
                <img src={stage.screenshot} alt={stage.screenshotAlt} loading="lazy" />
              </div>
            </div>
          </div>
        ))
      }
    </div></div>
  </div>
</section>

<script>
  const book = document.getElementById("book");
  const pages = document.querySelectorAll<HTMLDivElement>(".book-page");
  const count = pages.length;
  let timer: ReturnType<typeof setTimeout> | null = null;

  function activate(index: number) {
    pages.forEach((p, i) => {
      if (i === index) {
        p.classList.add("active");
      } else {
        p.classList.remove("active");
      }
    });
  }

  pages.forEach((page, i) => {
    page.addEventListener("mouseenter", () => {
      if (page.classList.contains("active")) return;
      if (timer) clearTimeout(timer);
      timer = setTimeout(() => activate(i), 80);
    });

    page.addEventListener("click", () => {
      if (timer) clearTimeout(timer);
      activate(i);
    });
  });

  book?.addEventListener("mouseleave", () => {
    if (timer) clearTimeout(timer);
  });
</script>

<style>
  .how-it-works {
    padding: 5rem 1.5rem;
    border-top: 1px solid rgba(13, 40, 24, 0.15);
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .book-wrapper {
    max-width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
  }

  h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .section-intro {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 1.125rem;
    max-width: 640px;
    margin: 0 auto 3rem;
    line-height: 1.6;
  }

  .book {
    display: flex;
    height: 480px;
    border-top: 1px solid rgba(13, 40, 24, 0.15);
    border-bottom: 1px solid rgba(13, 40, 24, 0.15);
    overflow: hidden;
  }

  .book-page {
    position: relative;
    flex: 0 0 60px;
    overflow: hidden;
    cursor: pointer;
    border-right: 1px solid rgba(13, 40, 24, 0.15);
    transition: flex 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .book-page:last-child {
    border-right: none;
  }

  .book-page.active {
    flex: 1 0 0;
    cursor: default;
  }

  /* Spine — always rendered, fades out when active */
  .page-spine {
    position: absolute;
    inset: 0;
    width: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-lr;
    text-orientation: mixed;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text);
    user-select: none;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .book-page.active .page-spine {
    opacity: 0;
    pointer-events: none;
  }

  /* Content — always rendered, fades in when active */
  .page-content {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 2rem;
    align-items: center;
    padding: 2rem;
    height: 100%;
    opacity: 0;
    transition: opacity 0.4s ease 0.15s;
  }

  .book-page.active .page-content {
    opacity: 1;
  }

  .page-text {
    display: flex;
    flex-direction: column;
  }

  .page-icon {
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border: 1px solid rgba(13, 40, 24, 0.15);
    border-radius: 12px;
    color: var(--color-text);
  }

  .page-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--color-text);
    opacity: 0.6;
    margin-bottom: 0.25rem;
  }

  .page-name {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .page-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .page-screenshot {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(13, 40, 24, 0.15);
    max-height: 420px;
  }

  .page-screenshot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    display: block;
  }

  @media (max-width: 768px) {
    .book {
      flex-direction: column;
      height: auto;
    }

    .book-page {
      flex: 0 0 48px;
      border-right: none;
      border-bottom: 1px solid rgba(13, 40, 24, 0.15);
      transition: flex 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .book-page:last-child {
      border-bottom: none;
    }

    .book-page.active {
      flex: 1 0 auto;
    }

    .page-spine {
      width: 100%;
      writing-mode: horizontal-tb;
      text-orientation: initial;
    }

    .page-content {
      display: flex;
      flex-direction: column;
      padding: 1.5rem;
    }

    .page-screenshot {
      max-height: 300px;
    }
  }
</style>
