---
import SlackIcon from "./icons/SlackIcon.astro";
import LinearIcon from "./icons/LinearIcon.astro";
import GitHubIcon from "./icons/GitHubIcon.astro";
---

<header class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <div class="hero-badge">AI Engineering Agent</div>
      <h1>The AI engineering agent that works while you don't.</h1>
      <p class="hero-subtitle">
        Vera is the async AI engineer embedded in Slack, Linear, and GitHub.
        Delegate a task in a DM. Wake up to a merged pull request.
      </p>
      <p class="sr-only">
        Vera is an autonomous AI engineering agent built for teams that ship fast.
        Unlike IDE copilots that need you at the keyboard, Vera works
        asynchronously: researching codebases, triaging bugs, writing
        implementations, and opening pull requests while you focus on what matters.
        Tell Vera what to build in a Slack DM or assign a Linear ticket. She does
        the rest.
      </p>
      <div class="hero-ctas">
        <a href="#cta" class="btn btn-primary">Add to Slack</a>
        <a href="#how-it-works" class="btn btn-secondary">See Linear ↓</a>
      </div>
    </div>

    <div class="hero-bubbles" aria-hidden="true">
      <div class="bubble bubble-clock">
        <span class="bubble-text">24/7</span>
      </div>
      <div class="bubble bubble-slack">
        <SlackIcon size={28} />
      </div>
      <div class="bubble bubble-linear">
        <LinearIcon size={28} />
      </div>
      <div class="bubble bubble-github">
        <GitHubIcon size={28} />
      </div>
      <div class="bubble bubble-pr">
        <span class="bubble-text">PRs</span>
      </div>
      <div class="bubble bubble-async">
        <span class="bubble-text">Async</span>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    padding: 6rem 1.5rem 4rem;
  }

  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.35rem 1rem;
    border: 1px solid rgba(13, 40, 24, 0.3);
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    transition: all 0.2s ease;
    min-width: 180px;
  }

  .btn-primary {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .btn-primary:hover {
    opacity: 0.85;
    color: var(--color-bg);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid rgba(13, 40, 24, 0.3);
  }

  .btn-secondary:hover {
    border-color: var(--color-text);
    transform: translateY(-2px);
  }

  /* Bubbles grid */
  .hero-bubbles {
    position: relative;
    height: 360px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 1rem;
    padding: 1rem;
  }

  .bubble {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(13, 40, 24, 0.12);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    aspect-ratio: 1;
    color: var(--color-text);
    transition: transform 0.3s ease;
  }

  .bubble:hover {
    transform: scale(1.08);
  }

  .bubble-text {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .bubble-clock {
    grid-column: 1;
    grid-row: 1;
    width: 90px;
    height: 90px;
    justify-self: end;
    align-self: center;
  }

  .bubble-clock .bubble-text {
    font-size: 1.1rem;
  }

  .bubble-slack {
    grid-column: 2;
    grid-row: 1;
    width: 72px;
    height: 72px;
    justify-self: center;
    align-self: end;
  }

  .bubble-linear {
    grid-column: 3;
    grid-row: 1;
    width: 68px;
    height: 68px;
    justify-self: start;
    align-self: center;
  }

  .bubble-github {
    grid-column: 1;
    grid-row: 2;
    width: 72px;
    height: 72px;
    justify-self: center;
    align-self: center;
  }

  .bubble-pr {
    grid-column: 2;
    grid-row: 2;
    width: 80px;
    height: 80px;
    justify-self: center;
    align-self: center;
  }

  .bubble-async {
    grid-column: 3;
    grid-row: 2;
    width: 76px;
    height: 76px;
    justify-self: center;
    align-self: start;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 4rem 1.5rem 3rem;
    }

    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-text {
      align-items: center;
      text-align: center;
    }

    .hero-subtitle {
      max-width: 640px;
      margin-left: auto;
      margin-right: auto;
    }

    .hero-ctas {
      justify-content: center;
    }

    .hero-bubbles {
      height: 240px;
      max-width: 320px;
      margin: 0 auto;
    }

    .btn {
      width: 100%;
      max-width: 320px;
    }
  }
</style>
