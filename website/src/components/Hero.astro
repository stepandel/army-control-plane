---
import SlackIcon from "./icons/SlackIcon.astro";
import LinearIcon from "./icons/LinearIcon.astro";
import GitHubIcon from "./icons/GitHubIcon.astro";
---

<header class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <div class="hero-badge">AI Engineering Agent</div>
      <h1>The AI engineering agent that works while you don't.</h1>
      <p class="hero-subtitle">
        Vera is the async AI engineer embedded in Slack, Linear, and GitHub.
        Delegate a task in a DM. Wake up to a merged pull request.
      </p>
      <p class="sr-only">
        Vera is an autonomous AI engineering agent built for teams that ship fast.
        Unlike IDE copilots that need you at the keyboard, Vera works
        asynchronously: researching codebases, triaging bugs, writing
        implementations, and opening pull requests while you focus on what matters.
        Tell Vera what to build in a Slack DM or assign a Linear ticket. She does
        the rest.
      </p>
      <div class="hero-ctas">
        <a href="#cta" class="btn btn-primary">Add to Slack</a>
        <a href="#how-it-works" class="btn btn-secondary">See Linear ↓</a>
      </div>
    </div>

    <div class="hero-bubbles" aria-hidden="true">
      <div class="bubble b1"><span class="bubble-label">24/7</span></div>
      <div class="bubble b2"><SlackIcon size={26} /></div>
      <div class="bubble b3"><LinearIcon size={26} /></div>
      <div class="bubble b4"><GitHubIcon size={26} /></div>
      <div class="bubble b5"><span class="bubble-label">PRs</span></div>
      <div class="bubble b6"><span class="bubble-label">Async</span></div>
    </div>
  </div>
</header>

<style>
  .hero {
    padding: 6rem 1.5rem 4rem;
  }

  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.35rem 1rem;
    border: 1px solid rgba(13, 40, 24, 0.3);
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    transition: all 0.2s ease;
    min-width: 180px;
  }

  .btn-primary {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .btn-primary:hover {
    opacity: 0.85;
    color: var(--color-bg);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid rgba(13, 40, 24, 0.3);
  }

  .btn-secondary:hover {
    border-color: var(--color-text);
    transform: translateY(-2px);
  }

  /* Bubbles */
  .hero-bubbles {
    position: relative;
    height: 380px;
  }

  .bubble {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(13, 40, 24, 0.12);
    background: rgba(255, 255, 255, 0.4);
    color: var(--color-text);
    transition: transform 0.3s ease;
  }

  .bubble:hover {
    transform: scale(1.1);
  }

  .bubble-label {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .b1 { width: 88px; height: 88px; top: 8%;  left: 55%; }
  .b1 .bubble-label { font-size: 1.1rem; }
  .b2 { width: 72px; height: 72px; top: 5%;  left: 15%; }
  .b3 { width: 68px; height: 68px; top: 32%; left: 5%;  }
  .b4 { width: 76px; height: 76px; top: 38%; left: 65%; }
  .b5 { width: 80px; height: 80px; top: 65%; left: 25%; }
  .b6 { width: 72px; height: 72px; top: 70%; left: 70%; }

  @media (max-width: 768px) {
    .hero {
      padding: 4rem 1.5rem 3rem;
    }

    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-text {
      align-items: center;
      text-align: center;
    }

    .hero-ctas {
      justify-content: center;
    }

    .hero-bubbles {
      height: 200px;
    }

    .btn {
      width: 100%;
      max-width: 320px;
    }
  }
</style>
