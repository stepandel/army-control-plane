---
interface Props {
  minimal?: boolean;
}

const { minimal = false } = Astro.props;
---

<nav class="nav" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Vera AI home">
      <span class="logo-text">Vera AI</span>
    </a>
    {!minimal && (
      <div class="nav-links" id="nav-links">
        <a href="/#how-it-works">Linear</a>
        <a href="/#github">GitHub</a>
        <a href="/#slack">Slack</a>
        <a href="/#use-cases">Use Cases</a>
        <a href="/pricing">Pricing</a>
        <a href="/security">Security</a>
        <div class="nav-links-cta">
          <a href="/sign-in" class="nav-signin">Sign in</a>
          <a href="/onboarding" class="nav-cta">Install Vera →</a>
        </div>
      </div>
    )}
    {!minimal && (
      <div class="nav-cta-group">
        <a href="/sign-in" class="nav-signin">Sign in</a>
        <a href="/onboarding" class="nav-cta">Install Vera →</a>
      </div>
    )}
    {!minimal && (
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" id="nav-toggle">
        <span class="hamburger"></span>
      </button>
    )}
  </div>
</nav>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.querySelector(".nav");
  if (toggle && nav) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      nav.classList.toggle("open");
    });
    // Close menu when a nav link is clicked
    nav.querySelectorAll(".nav-links a, .nav-cta-group a").forEach((a) => {
      a.addEventListener("click", () => {
        toggle.setAttribute("aria-expanded", "false");
        nav.classList.remove("open");
      });
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(240, 237, 232, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(13, 40, 24, 0.15);
    padding: 0 1.5rem;
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 2rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 900;
    font-size: 1.125rem;
    color: var(--color-text);
    white-space: nowrap;
  }

  .nav-logo:hover {
    color: var(--color-text);
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .nav-links a {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  .nav-cta-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-signin {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .nav-signin:hover {
    color: var(--color-text);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.25rem;
    background: var(--color-text);
    color: var(--color-bg) !important;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    transition: opacity 0.2s, transform 0.2s;
  }

  .nav-cta:hover {
    opacity: 0.85;
    color: var(--color-bg) !important;
    transform: translateY(-1px);
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .hamburger,
  .hamburger::before,
  .hamburger::after {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.2s;
  }

  .hamburger {
    position: relative;
  }

  .hamburger::before,
  .hamburger::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .hamburger::before {
    top: -7px;
  }

  .hamburger::after {
    top: 7px;
  }

  /* Mobile CTA group inside collapsible menu — hidden on desktop */
  .nav-links-cta {
    display: none;
  }

  @media (max-width: 768px) {
    .nav.open {
      background: rgb(240, 237, 232);
    }

    .nav-inner {
      flex-wrap: wrap;
      height: auto;
      min-height: 64px;
    }

    .nav-links {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: 0.75rem;
      padding: 1rem 0 0.5rem;
      order: 3;
    }

    .nav.open .nav-links {
      display: flex;
    }

    /* Hide the desktop CTA group on mobile */
    .nav-cta-group {
      display: none;
    }

    /* Show CTAs inside the collapsible menu on mobile */
    .nav-links-cta {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding-top: 0.75rem;
      border-top: 1px solid rgba(13, 40, 24, 0.1);
      margin-top: 0.25rem;
    }

    .nav-links-cta .nav-cta {
      padding: 0.625rem 1.25rem;
      font-size: 0.875rem;
      text-align: center;
      justify-content: center;
    }

    .nav-toggle {
      display: block;
    }

    /* Hamburger → X animation */
    .nav-toggle[aria-expanded="true"] .hamburger {
      background: transparent;
    }

    .nav-toggle[aria-expanded="true"] .hamburger::before {
      top: 0;
      transform: rotate(45deg);
    }

    .nav-toggle[aria-expanded="true"] .hamburger::after {
      top: 0;
      transform: rotate(-45deg);
    }
  }
</style>
