---
interface Props {
  size?: number;
  class?: string;
  variant?: "brand" | "mono";
}
const { size = 28, class: className = "", variant = "brand" } = Astro.props;
const fill = variant === "mono" ? "currentColor" : "#5E6AD2";
const cutout = variant === "mono" ? "var(--color-bg)" : "#F4F5F8";
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  class={className}
  role="img"
  aria-label="Linear logo"
>
  <circle cx="12" cy="12" r="10" fill={fill} />
  <g
    fill="none"
    stroke={cutout}
    stroke-width="1.9"
    stroke-linecap="round"
  >
    <line x1="4.5" y1="14.7" x2="9.8" y2="20" />
    <line x1="6.3" y1="12.9" x2="11.6" y2="18.2" />
    <line x1="8.1" y1="11.1" x2="13.4" y2="16.4" />
    <line x1="9.9" y1="9.3" x2="15.2" y2="14.6" />
    <line x1="11.7" y1="7.5" x2="17" y2="12.8" />
  </g>
</svg>
