---
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className = "" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role="img"
  aria-label="Research icon"
>
  <!-- Magnifying glass with document -->
  <circle cx="11" cy="11" r="7" />
  <line x1="16.5" y1="16.5" x2="21" y2="21" />
  <line x1="8.5" y1="8.5" x2="13.5" y2="8.5" />
  <line x1="8.5" y1="11" x2="12" y2="11" />
  <line x1="8.5" y1="13.5" x2="11" y2="13.5" />
</svg>
