---
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className = "" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role="img"
  aria-label="Triage icon"
>
  <!-- Bug with diagnostic lines -->
  <circle cx="12" cy="14" r="6" />
  <path d="M12 8V2" />
  <path d="M4.93 10.93L2 8" />
  <path d="M19.07 10.93L22 8" />
  <path d="M4.93 17.07L2 20" />
  <path d="M19.07 17.07L22 20" />
  <line x1="9" y1="13" x2="15" y2="13" />
  <line x1="9" y1="16" x2="15" y2="16" />
</svg>
