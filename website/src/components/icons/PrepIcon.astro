---
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className = "" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role="img"
  aria-label="Prep and plan icon"
>
  <!-- Clipboard with checklist -->
  <path d="M9 2h6a1 1 0 0 1 1 1v1H8V3a1 1 0 0 1 1-1z" />
  <rect x="4" y="4" width="16" height="18" rx="2" />
  <line x1="8" y1="10" x2="8" y2="10.01" stroke-width="2.5" />
  <line x1="11" y1="10" x2="16" y2="10" />
  <line x1="8" y1="14" x2="8" y2="14.01" stroke-width="2.5" />
  <line x1="11" y1="14" x2="16" y2="14" />
  <line x1="8" y1="18" x2="8" y2="18.01" stroke-width="2.5" />
  <line x1="11" y1="18" x2="14" y2="18" />
</svg>
