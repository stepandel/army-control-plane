---
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className = "" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role="img"
  aria-label="Review icon"
>
  <!-- Eye with code brackets -->
  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
  <circle cx="12" cy="12" r="3" />
  <path d="M9 12l-1.5-1.5" stroke-width="1" opacity="0.5" />
  <path d="M15 12l1.5 1.5" stroke-width="1" opacity="0.5" />
</svg>
