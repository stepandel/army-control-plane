<section id="cta" class="cta-section" aria-labelledby="cta-heading">
  <div class="cta-inner">
    <h2 id="cta-heading">Start delegating to your AI engineering agent</h2>
    <p class="cta-body">
      Install Vera to Slack and assign your first task. She'll research the problem,
      write the code, and open a PR. All before your next standup.
    </p>
    <div class="cta-buttons">
      <a href="/onboarding" class="btn btn-primary">Install Vera</a>
      <a href="mailto:hello@agent-army.ai" class="btn btn-secondary"
        >Contact us for a demo →</a
      >
    </div>
  </div>
</section>

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-logo">Vera AI</span>
      <p class="footer-legal">
        A product of <strong>Arsent LLC</strong> · San Francisco, CA
      </p>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="/pricing">Pricing</a>
      <a href="/security">Security</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/subprocessors">Subprocessors</a>
      <a href="mailto:hello@agent-army.ai">Contact</a>
    </nav>
    <p class="footer-copyright">
      © 2026 Arsent LLC. All rights reserved. · Built with <a
        href="https://claude.com"
        target="_blank"
        rel="noopener noreferrer">Claude</a
      >
    </p>
  </div>
</footer>

<style>
  .cta-section {
    padding: 6rem 1.5rem;
    text-align: center;
    border-top: 1px solid rgba(13, 40, 24, 0.15);
  }

  .cta-inner {
    max-width: 600px;
    margin: 0 auto;
  }

  h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .cta-body {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    transition: all 0.2s ease;
    min-width: 180px;
  }

  .btn-primary {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .btn-primary:hover {
    opacity: 0.85;
    color: var(--color-bg);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid rgba(13, 40, 24, 0.3);
  }

  .btn-secondary:hover {
    border-color: var(--color-text);
    transform: translateY(-2px);
  }

  .footer {
    padding: 2rem 1.5rem;
    border-top: 1px solid rgba(13, 40, 24, 0.15);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-logo {
    font-weight: 900;
    font-size: 1rem;
  }

  .footer-legal {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    opacity: 0.85;
  }

  .footer-legal strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .footer-links {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .footer-links a {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .footer-links a:hover {
    color: var(--color-text);
  }

  .footer-sep {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .footer-copyright {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .footer-copyright a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .footer-copyright a:hover {
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }

    .btn {
      width: 100%;
      max-width: 320px;
    }

    .footer-inner {
      flex-direction: column;
      text-align: center;
    }

    .footer-links {
      justify-content: center;
    }
  }
</style>
