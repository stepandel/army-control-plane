---
---

<section id="cta" class="cta-section" aria-labelledby="cta-heading">
  <div class="cta-inner">
    <h2 id="cta-heading">Start delegating to your AI engineering agent</h2>
    <p class="cta-body">
      Install Vera to Slack and assign your first task. She'll research the problem,
      write the code, and open a PR. All before your next standup.
    </p>
    <div class="cta-buttons">
      <a href="/onboarding" class="btn btn-primary">Install Vera</a>
      <a href="mailto:hello@agent-army.ai" class="btn btn-secondary"
        >Contact us for a demo →</a
      >
    </div>
  </div>
</section>

<footer class="footer">
  <div class="footer-main">
    <div class="footer-tagline">
      <p>The async AI engineering agent for Slack, Linear &amp; GitHub.</p>
      <p class="footer-tagline-sub">
        Delegate a task in a DM. Wake up to a merged pull request.
      </p>
    </div>
    <nav class="footer-cols" aria-label="Footer navigation">
      <div class="footer-col">
        <h3 class="footer-heading">Product</h3>
        <a href="/pricing">Pricing</a>
        <a href="/security">Security</a>
        <a href="mailto:hello@agent-army.ai">Contact</a>
      </div>
      <div class="footer-col">
        <h3 class="footer-heading">Legal</h3>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/subprocessors">Subprocessors</a>
      </div>
    </nav>
  </div>
  <div class="footer-bottom">
    <p class="footer-legal">
      A product of <strong>Arsent LLC</strong> · San Francisco, CA
    </p>
  </div>
</footer>

<style>
  .cta-section {
    padding: 6rem 1.5rem;
    text-align: center;
    border-top: 1px solid rgba(13, 40, 24, 0.15);
  }

  .cta-inner {
    max-width: 600px;
    margin: 0 auto;
  }

  h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .cta-body {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    transition: all 0.2s ease;
    min-width: 180px;
  }

  .btn-primary {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .btn-primary:hover {
    opacity: 0.85;
    color: var(--color-bg);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid rgba(13, 40, 24, 0.3);
  }

  .btn-secondary:hover {
    border-color: var(--color-text);
    transform: translateY(-2px);
  }

  .footer {
    border-top: 1px solid rgba(13, 40, 24, 0.15);
    padding: 0 1.5rem;
  }

  .footer-main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4rem 0 3.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 4rem;
  }

  .footer-tagline {
    max-width: 360px;
  }

  .footer-tagline p {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.5;
  }

  .footer-tagline-sub {
    margin-top: 0.5rem;
    font-size: 0.9rem !important;
    font-weight: 400 !important;
    color: var(--color-text-muted) !important;
    opacity: 0.75;
  }

  .footer-cols {
    display: flex;
    gap: 5rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 100px;
  }

  .footer-heading {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .footer-col a {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    opacity: 0.8;
    transition: opacity 0.2s;
  }

  .footer-col a:hover {
    opacity: 1;
  }

  .footer-bottom {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(13, 40, 24, 0.1);
  }

  .footer-legal {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    opacity: 0.75;
  }

  .footer-legal strong {
    color: var(--color-text);
    font-weight: 600;
    opacity: 1;
  }

  @media (max-width: 768px) {
    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }

    .btn {
      width: 100%;
      max-width: 320px;
    }

    .footer-main {
      flex-direction: column;
      gap: 3rem;
      padding: 3rem 0 2.5rem;
    }

    .footer-cols {
      gap: 4rem;
    }

    .footer-bottom {
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .footer-cols {
      gap: 3rem;
    }
  }
</style>
