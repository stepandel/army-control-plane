---
import SlackIcon from "./icons/SlackIcon.astro";
import LinearIcon from "./icons/LinearIcon.astro";
import GitHubIcon from "./icons/GitHubIcon.astro";

const integrations = [
  {
    name: "Slack",
    iconComponent: "slack",
    description:
      "Delegate tasks in a DM. Get progress updates in threads. Review results without leaving your conversation.",
  },
  {
    name: "Linear",
    iconComponent: "linear",
    description:
      "Assign tickets directly. Vera reads descriptions, adds research, and moves tickets through your workflow — from Backlog to In Review.",
  },
  {
    name: "GitHub",
    iconComponent: "github",
    description:
      "Vera opens pull requests, responds to review comments, and iterates on feedback. Code lands in your repo following your team's conventions.",
  },
];
---

<section
  id="integrations"
  class="integrations"
  aria-labelledby="int-heading"
>
  <div class="section-inner">
    <h2 id="int-heading">Built into the tools you already use</h2>
    <p class="section-intro">
      No new IDE. No standalone workspace. Vera works where your team works.
    </p>

    <div class="integration-grid">
      {
        integrations.map((item) => (
          <div class="integration-card">
            <div class="integration-icon">
              {item.iconComponent === "slack" && <SlackIcon size={32} />}
              {item.iconComponent === "linear" && <LinearIcon size={32} />}
              {item.iconComponent === "github" && <GitHubIcon size={32} />}
            </div>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .integrations {
    padding: 5rem 1.5rem;
    border-top: 1px solid rgba(232, 245, 238, 0.15);
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .section-intro {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 1.125rem;
    max-width: 640px;
    margin: 0 auto 3rem;
    line-height: 1.6;
  }

  .integration-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .integration-card {
    text-align: center;
    padding: 2rem 1.5rem;
    border: 1px solid rgba(232, 245, 238, 0.15);
    border-radius: 16px;
    transition: border-color 0.2s, transform 0.2s;
  }

  .integration-card:hover {
    border-color: var(--color-text);
    transform: translateY(-2px);
  }

  .integration-icon {
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 16px;
    margin-left: auto;
    margin-right: auto;
    color: var(--color-text);
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .integration-card p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .integration-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
