---
export const prerender = false;

import OnboardingLayout from "../layouts/OnboardingLayout.astro";

const env = Astro.locals.runtime.env;
const apiBase = env.API_BASE_URL;

const cookie = Astro.request.headers.get("cookie");
if (cookie?.includes("__Host-session=")) {
  const { verifyJwt } = await import("../lib/jwt");
  const token = cookie.match(/(?:^|;\s*)__Host-session=([^;]*)/)?.[1];
  if (token) {
    const session = await verifyJwt(token, env.SESSION_SECRET);
    if (session) return Astro.redirect("/account");
  }
}

const error = new URL(Astro.request.url).searchParams.get("error");
const providers = [
  { name: "Google", href: `${apiBase}/auth/google/authorize`, className: "btn-google" },
  { name: "GitHub", href: `${apiBase}/auth/github/authorize`, className: "btn-github" },
  { name: "Discord", href: `${apiBase}/auth/discord/authorize`, className: "btn-discord" },
];
const slackAuthorizeUrl = `${apiBase}/auth/slack/authorize`;
---

<OnboardingLayout title="Vera — Sign In">
  <div class="sign-in">
    <h1>Sign in to Vera</h1>
    <p class="subtitle">Use Google, GitHub, or Discord for your account. Existing workspace users can still sign in with Slack.</p>

    {error === "team_not_found" && (
      <div class="error-banner">
        Your Slack workspace has not installed Vera yet. <a href="/onboarding">Create an account instead.</a>
      </div>
    )}

    {error === "oauth_failed" && (
      <div class="error-banner">
        Sign-in failed. Please try again.
      </div>
    )}

    <div class="provider-grid">
      {providers.map((provider) => (
        <a href={provider.href} class={`provider-btn ${provider.className}`}>
          Continue with {provider.name}
        </a>
      ))}
    </div>

    <div class="slack-card">
      <p class="slack-label">Existing Slack-backed workspace?</p>
      <a href={slackAuthorizeUrl} class="provider-btn btn-slack">Sign in with Slack</a>
    </div>

    <p class="footer-link">
      Need an account first? <a href="/onboarding">Create one here.</a>
    </p>
  </div>
</OnboardingLayout>

<style>
  .sign-in {
    text-align: center;
    padding-top: 2rem;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 2rem;
    opacity: 0.75;
  }

  .error-banner {
    background: rgba(220, 38, 38, 0.06);
    border: 1px solid rgba(220, 38, 38, 0.2);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: #991b1b;
  }

  .error-banner a {
    color: inherit;
    text-decoration: underline;
    font-weight: 600;
  }

  .provider-grid {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .provider-btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    border: 1px solid rgba(13, 40, 24, 0.15);
    transition: transform 0.15s, opacity 0.15s, border-color 0.15s;
  }

  .provider-btn:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  .btn-google {
    background: #ffffff;
    color: #1f2937;
  }

  .btn-github {
    background: #111827;
    color: #f9fafb;
  }

  .btn-discord {
    background: #5865f2;
    color: #ffffff;
    border-color: #5865f2;
  }

  .btn-slack {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .slack-card {
    border-top: 1px solid rgba(13, 40, 24, 0.12);
    padding-top: 1.5rem;
  }

  .slack-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.55;
    margin-bottom: 0.75rem;
  }

  .footer-link {
    margin-top: 1.75rem;
    font-size: 0.85rem;
    opacity: 0.65;
  }

  .footer-link a {
    text-decoration: underline;
  }
</style>
