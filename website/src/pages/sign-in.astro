---
export const prerender = false;

import OnboardingLayout from "../layouts/OnboardingLayout.astro";

const env = Astro.locals.runtime.env;
const apiBase = env.API_BASE_URL;

// If user already has a valid session, send them to /account
const cookie = Astro.request.headers.get("cookie");
if (cookie?.includes("__Host-session=")) {
  const { verifyJwt } = await import("../lib/jwt");
  const token = cookie.match(/(?:^|;\s*)__Host-session=([^;]*)/)?.[1];
  if (token) {
    const session = await verifyJwt(token, env.SESSION_SECRET);
    if (session) return Astro.redirect("/account");
  }
}

const error = new URL(Astro.request.url).searchParams.get("error");
const authorizeUrl = `${apiBase}/auth/slack/authorize`;
---

<OnboardingLayout title="Vera — Sign In">
  <div class="sign-in">
    <h1>Sign in to Vera</h1>
    <p class="subtitle">Use your Slack account to access your team's dashboard.</p>

    {error === "team_not_found" && (
      <div class="error-banner">
        ⚠️ Your Slack team hasn't installed Vera yet. <a href="/onboarding">Install Vera →</a>
      </div>
    )}

    {error === "oidc_failed" && (
      <div class="error-banner">
        ⚠️ Sign-in failed. Please try again.
      </div>
    )}

    <a href={authorizeUrl} class="btn-slack">
      <svg width="18" height="18" viewBox="0 0 123 123" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M25.8 77.6c0 7.1-5.8 12.9-12.9 12.9S0 84.7 0 77.6s5.8-12.9 12.9-12.9h12.9v12.9zm6.5 0c0-7.1 5.8-12.9 12.9-12.9s12.9 5.8 12.9 12.9v32.3c0 7.1-5.8 12.9-12.9 12.9s-12.9-5.8-12.9-12.9V77.6z" fill="#E01E5A"/>
        <path d="M45.2 25.8c-7.1 0-12.9-5.8-12.9-12.9S38.1 0 45.2 0s12.9 5.8 12.9 12.9v12.9H45.2zm0 6.5c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9H12.9C5.8 58.1 0 52.3 0 45.2s5.8-12.9 12.9-12.9h32.3z" fill="#36C5F0"/>
        <path d="M97.2 45.2c0-7.1 5.8-12.9 12.9-12.9s12.9 5.8 12.9 12.9-5.8 12.9-12.9 12.9H97.2V45.2zm-6.5 0c0 7.1-5.8 12.9-12.9 12.9s-12.9-5.8-12.9-12.9V12.9C64.9 5.8 70.7 0 77.8 0s12.9 5.8 12.9 12.9v32.3z" fill="#2EB67D"/>
        <path d="M77.8 97.2c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9-12.9-5.8-12.9-12.9V97.2h12.9zm0-6.5c-7.1 0-12.9-5.8-12.9-12.9s5.8-12.9 12.9-12.9h32.3c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9H77.8z" fill="#ECB22E"/>
      </svg>
      Sign in with Slack
    </a>

    <p class="install-link">
      Don't have Vera installed yet? <a href="/onboarding">Install Vera →</a>
    </p>
  </div>
</OnboardingLayout>

<style>
  .sign-in {
    text-align: center;
    padding-top: 2rem;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 2rem;
    opacity: 0.7;
  }

  .error-banner {
    background: rgba(220, 38, 38, 0.06);
    border: 1px solid rgba(220, 38, 38, 0.2);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: #991b1b;
  }

  .error-banner a {
    color: #991b1b;
    text-decoration: underline;
    font-weight: 600;
  }

  .btn-slack {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-text);
    color: var(--color-bg) !important;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: opacity 0.15s, transform 0.15s;
    cursor: pointer;
  }

  .btn-slack:hover {
    opacity: 0.85;
    color: var(--color-bg) !important;
    transform: translateY(-1px);
  }

  .install-link {
    margin-top: 2rem;
    font-size: 0.8rem;
    opacity: 0.6;
  }

  .install-link a {
    text-decoration: underline;
  }
</style>
