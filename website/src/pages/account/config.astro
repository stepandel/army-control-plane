---
export const prerender = false;

import OnboardingLayout from "../../layouts/OnboardingLayout.astro";
import { verifyJwt } from "../../lib/jwt";

const env = Astro.locals.runtime.env;
const apiBase = env.API_BASE_URL;
const controlPlane: { fetch: typeof fetch } = env.CONTROL_PLANE;

// ── Session check ────────────────────────────────────────────────
const cookie = Astro.request.headers.get("cookie");
const sessionToken = cookie?.match(/(?:^|;\s*)__Host-session=([^;]*)/)?.[1];

if (!sessionToken) {
  return Astro.redirect("/sign-in");
}

const session = await verifyJwt(sessionToken, env.SESSION_SECRET);
if (!session) {
  return Astro.redirect("/sign-in");
}

// ── Fetch config from control plane via service binding ─────────
// Service bindings DO NOT auto-forward browser cookies — must pass it
// explicitly so sessionGuard on the control plane sees the session.
type SkillSummary = {
  name: string;
  description: string;
  scopes: string[];
  file_path: string;
  has_scripts: boolean;
  has_references: boolean;
};

type WorkflowInputSummary = {
  name: string;
  description?: string;
  default?: string;
  required?: boolean;
};

type WorkflowSummary = {
  name: string;
  description: string;
  inputs: WorkflowInputSummary[];
  step_count: number;
  has_approval_gates: boolean;
  file_path: string;
};

type CronSummary = {
  name: string;
  description: string;
  schedule: string;
  timezone?: string;
  enabled: boolean;
  type: string;
  workflow?: string;
  prompt?: string;
  file_path: string;
};

type ConfigBundle = {
  skills: SkillSummary[];
  workflows: WorkflowSummary[];
  crons: CronSummary[];
  errors: string[];
};

let config: ConfigBundle | null = null;
let errorState: "not_provisioned" | "unavailable" | null = null;
let tenantName: string | null = null;

try {
  const res = await controlPlane.fetch("https://api/api/account/config", {
    headers: { cookie: cookie ?? "" },
  });

  if (res.status === 401) {
    return Astro.redirect("/sign-in");
  } else if (res.status === 404) {
    errorState = "not_provisioned";
  } else if (!res.ok) {
    errorState = "unavailable";
  } else {
    config = (await res.json()) as ConfigBundle;
  }
} catch (err) {
  console.error("[/account/config] failed to load config:", err);
  errorState = "unavailable";
}

// Pull tenant display name in parallel via the /tenant endpoint so the
// header matches the other account pages.
try {
  const tenantRes = await controlPlane.fetch("https://api/api/account/tenant", {
    headers: { cookie: cookie ?? "" },
  });
  if (tenantRes.ok) {
    const data = (await tenantRes.json()) as { tenant?: { name?: string } };
    tenantName = data.tenant?.name ?? null;
  }
} catch {
  // Non-fatal — header just won't show the tenant name.
}

// ── Helpers ──────────────────────────────────────────────────────

/**
 * Render a cron expression as a friendly English description for the most
 * common patterns. Falls back to the raw expression for anything we don't
 * explicitly recognize. Doesn't require an external library.
 */
function humanizeCron(expr: string): string | null {
  const parts = expr.trim().split(/\s+/);
  if (parts.length !== 5) return null;
  const [min, hour, dom, month, dow] = parts;

  const daysOfWeek = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
  const fmtTime = (h: string, m: string): string => {
    const hh = parseInt(h, 10);
    const mm = parseInt(m, 10);
    if (Number.isNaN(hh) || Number.isNaN(mm)) return `${h}:${m}`;
    const period = hh >= 12 ? "PM" : "AM";
    const display = hh % 12 === 0 ? 12 : hh % 12;
    return `${display}:${mm.toString().padStart(2, "0")} ${period}`;
  };

  // Every minute / every N minutes
  if (min === "*" && hour === "*" && dom === "*" && month === "*" && dow === "*") {
    return "Every minute";
  }
  const everyN = min.match(/^\*\/(\d+)$/);
  if (everyN && hour === "*" && dom === "*" && month === "*" && dow === "*") {
    return `Every ${everyN[1]} minutes`;
  }

  // Specific time daily
  if (/^\d+$/.test(min) && /^\d+$/.test(hour) && dom === "*" && month === "*") {
    const time = fmtTime(hour, min);
    if (dow === "*") return `Daily at ${time}`;
    if (dow === "1-5") return `Weekdays at ${time}`;
    if (dow === "0,6" || dow === "6,0") return `Weekends at ${time}`;
    if (/^\d$/.test(dow)) return `Every ${daysOfWeek[parseInt(dow, 10)]} at ${time}`;
    if (/^[0-6](,[0-6])+$/.test(dow)) {
      const days = dow.split(",").map((d) => daysOfWeek[parseInt(d, 10)]).join(", ");
      return `${days} at ${time}`;
    }
  }

  return null;
}

const skills = config?.skills ?? [];
const workflows = config?.workflows ?? [];
const crons = config?.crons ?? [];
const allEmpty =
  config !== null && skills.length === 0 && workflows.length === 0 && crons.length === 0;
---

<OnboardingLayout title="Vera — Configuration">
  <div class="account">
    <div class="account-header">
      <h1>{tenantName ?? "Configuration"}</h1>
      <p class="subtitle">Agent configuration</p>
    </div>

    <nav class="account-nav">
      <a href="/account">Overview</a>
      <a href="/account/billing">Billing</a>
      <a href="/account/config" class="active">Configuration</a>
    </nav>

    {errorState === "not_provisioned" && (
      <div class="empty-state">
        <p>Your agent is still being provisioned.</p>
        <p class="subtle">Configuration will appear here once your Vera machine is up.</p>
        <a href="/account" class="btn btn-secondary">Back to overview</a>
      </div>
    )}

    {errorState === "unavailable" && (
      <div class="empty-state error">
        <p>Couldn't load configuration.</p>
        <p class="subtle">There was a problem reading your agent's storage. Try again in a moment.</p>
        <button class="btn btn-secondary" id="retry-btn">Retry</button>
      </div>
    )}

    {config && allEmpty && (
      <div class="empty-state">
        <p>No skills, workflows, or crons configured yet.</p>
        <p class="subtle">As your Vera agent picks up new skills they'll show up here.</p>
      </div>
    )}

    {config && !allEmpty && (
      <Fragment>
        {config.errors.length > 0 && (
          <div class="banner warning-banner">
            ⚠️ {config.errors.length} file{config.errors.length !== 1 ? "s" : ""} couldn't be parsed and were skipped.
          </div>
        )}

        {/* ── Skills ──────────────────────────────────────────── */}
        <section class="section">
          <div class="section-header">
            <h2>Skills</h2>
            <span class="count">{skills.length}</span>
          </div>
          {skills.length === 0 ? (
            <p class="muted">No skills.</p>
          ) : (
            <div class="cards">
              {skills.map((skill) => (
                <div class="card">
                  <div class="card-head">
                    <div class="card-title">{skill.name}</div>
                  </div>
                  {skill.description && <div class="card-desc">{skill.description}</div>}
                  <div class="card-meta">
                    {skill.scopes.length > 0 && (
                      <div class="badges">
                        {skill.scopes.map((s) => (
                          <span class="badge">{s}</span>
                        ))}
                      </div>
                    )}
                    {(skill.has_scripts || skill.has_references) && (
                      <div class="badges">
                        {skill.has_scripts && <span class="badge badge-info">scripts</span>}
                        {skill.has_references && <span class="badge badge-info">references</span>}
                      </div>
                    )}
                  </div>
                  <div class="card-path">{skill.file_path}</div>
                </div>
              ))}
            </div>
          )}
        </section>

        {/* ── Workflows ───────────────────────────────────────── */}
        <section class="section">
          <div class="section-header">
            <h2>Workflows</h2>
            <span class="count">{workflows.length}</span>
          </div>
          {workflows.length === 0 ? (
            <p class="muted">No workflows.</p>
          ) : (
            <div class="cards">
              {workflows.map((wf) => (
                <div class="card">
                  <div class="card-head">
                    <div class="card-title">{wf.name}</div>
                    {wf.has_approval_gates && (
                      <span class="badge badge-warning">approval</span>
                    )}
                  </div>
                  {wf.description && <div class="card-desc">{wf.description}</div>}
                  <div class="card-meta">
                    <div class="meta-row">
                      <span>{wf.inputs.length} input{wf.inputs.length !== 1 ? "s" : ""}</span>
                      <span class="dot">·</span>
                      <span>{wf.step_count} step{wf.step_count !== 1 ? "s" : ""}</span>
                    </div>
                  </div>
                  <div class="card-path">{wf.file_path}</div>
                </div>
              ))}
            </div>
          )}
        </section>

        {/* ── Crons ──────────────────────────────────────────── */}
        <section class="section">
          <div class="section-header">
            <h2>Scheduled jobs</h2>
            <span class="count">{crons.length}</span>
          </div>
          {crons.length === 0 ? (
            <p class="muted">No scheduled jobs.</p>
          ) : (
            <div class="cards">
              {crons.map((cron) => {
                const human = humanizeCron(cron.schedule);
                return (
                  <div class={`card ${!cron.enabled ? "card-disabled" : ""}`}>
                    <div class="card-head">
                      <div class="card-title">
                        <span class={`status-dot ${cron.enabled ? "on" : "off"}`} />
                        {cron.name}
                      </div>
                      <span class="badge">{cron.type}</span>
                    </div>
                    {cron.description && <div class="card-desc">{cron.description}</div>}
                    <div class="card-meta">
                      <div class="schedule">
                        {human && <span class="schedule-human">{human}</span>}
                        <code class="schedule-raw">{cron.schedule}</code>
                        {cron.timezone && <span class="schedule-tz">{cron.timezone}</span>}
                      </div>
                      {(cron.workflow || cron.prompt) && (
                        <div class="meta-row meta-secondary">
                          {cron.workflow && (
                            <span>→ workflow: <code>{cron.workflow}</code></span>
                          )}
                          {cron.prompt && (
                            <span>→ prompt</span>
                          )}
                        </div>
                      )}
                    </div>
                    <div class="card-path">{cron.file_path}</div>
                  </div>
                );
              })}
            </div>
          )}
        </section>
      </Fragment>
    )}
  </div>
</OnboardingLayout>

<script>
  document.getElementById("retry-btn")?.addEventListener("click", () => {
    window.location.reload();
  });
</script>

<style>
  .account-header { margin-bottom: 1.5rem; }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .subtitle {
    font-size: 0.875rem;
    opacity: 0.6;
  }

  .account-nav {
    display: flex;
    gap: 1.5rem;
    border-bottom: 1px solid rgba(13, 40, 24, 0.15);
    margin-bottom: 2rem;
  }

  .account-nav a {
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.5rem 0;
    margin-bottom: -1px;
    color: var(--color-text-muted);
    opacity: 0.6;
    border-bottom: 2px solid transparent;
  }

  .account-nav a:hover { opacity: 0.85; }

  .account-nav a.active {
    opacity: 1;
    border-bottom-color: var(--color-text);
  }

  .section { margin-bottom: 2.25rem; }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    margin-bottom: 0.875rem;
  }

  .section h2 {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .count {
    font-size: 0.75rem;
    font-weight: 500;
    opacity: 0.5;
    background: rgba(13, 40, 24, 0.08);
    padding: 0.125rem 0.5rem;
    border-radius: 10px;
  }

  .muted {
    font-size: 0.8125rem;
    opacity: 0.55;
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card {
    border: 1px solid rgba(13, 40, 24, 0.15);
    border-radius: 10px;
    padding: 0.875rem 1.125rem;
    background: rgba(255, 255, 255, 0.35);
    transition: border-color 0.15s;
  }

  .card:hover {
    border-color: rgba(13, 40, 24, 0.3);
  }

  .card-disabled {
    opacity: 0.55;
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .card-title {
    font-weight: 600;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .card-desc {
    font-size: 0.8125rem;
    line-height: 1.45;
    opacity: 0.75;
    margin-bottom: 0.5rem;
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .card-path {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    opacity: 0.4;
    margin-top: 0.5rem;
    word-break: break-all;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .meta-secondary {
    opacity: 0.6;
  }

  .meta-secondary code {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    background: rgba(13, 40, 24, 0.06);
    padding: 0.05rem 0.3rem;
    border-radius: 3px;
  }

  .dot {
    opacity: 0.5;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .badge {
    font-size: 0.6875rem;
    font-weight: 500;
    padding: 0.125rem 0.5rem;
    border-radius: 10px;
    background: rgba(13, 40, 24, 0.08);
    color: var(--color-text);
    border: 1px solid rgba(13, 40, 24, 0.12);
  }

  .badge-info {
    background: rgba(30, 64, 175, 0.08);
    border-color: rgba(30, 64, 175, 0.2);
    color: #1e40af;
  }

  .badge-warning {
    background: rgba(180, 83, 9, 0.08);
    border-color: rgba(180, 83, 9, 0.2);
    color: #92400e;
  }

  .status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .status-dot.on {
    background: #16a34a;
    box-shadow: 0 0 0 2px rgba(22, 163, 74, 0.15);
  }

  .status-dot.off {
    background: #9ca3af;
  }

  .schedule {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
  }

  .schedule-human {
    font-weight: 500;
  }

  .schedule-raw {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    background: rgba(13, 40, 24, 0.06);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    opacity: 0.75;
  }

  .schedule-tz {
    opacity: 0.55;
  }

  .empty-state {
    border: 1px dashed rgba(13, 40, 24, 0.25);
    border-radius: 10px;
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .empty-state p {
    font-size: 0.875rem;
    margin-bottom: 0.4rem;
  }

  .empty-state .subtle {
    font-size: 0.8125rem;
    opacity: 0.6;
    margin-bottom: 1.25rem;
  }

  .empty-state.error {
    border-color: rgba(220, 38, 38, 0.3);
    background: rgba(220, 38, 38, 0.04);
  }

  .banner {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.8125rem;
    margin-bottom: 1.5rem;
  }

  .warning-banner {
    background: rgba(180, 83, 9, 0.06);
    border: 1px solid rgba(180, 83, 9, 0.2);
    color: #92400e;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    font-family: inherit;
    transition: all 0.15s;
  }

  .btn-secondary {
    background: transparent;
    border: 1px solid rgba(13, 40, 24, 0.3);
    color: var(--color-text);
  }

  .btn-secondary:hover {
    border-color: var(--color-text);
  }
</style>
