---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import GitHub from "../components/GitHub.astro";
import Slack from "../components/Slack.astro";
import UseCases from "../components/UseCases.astro";
import CTAFooter from "../components/CTAFooter.astro";
---

<Layout
  title="Vera — Ship What You Meant, Not What You Wrote | AI Engineering Agent"
  description="Vera turns feature requests into detailed specs, gets your sign-off, then ships the PR. Async AI engineering agent embedded in Slack, Linear, and GitHub — no IDE, no babysitting."
>
  <Nav />
  <main>
    <Hero />
    <HowItWorks />
    <GitHub />
    <Slack />
    <UseCases />
  </main>
  <CTAFooter />
</Layout>
