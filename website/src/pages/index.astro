---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import GitHub from "../components/GitHub.astro";
import Slack from "../components/Slack.astro";
import UseCases from "../components/UseCases.astro";
import CTAFooter from "../components/CTAFooter.astro";
---

<Layout
  title="Vera — AI Engineering Agent for Slack, Linear & GitHub | Vera AI"
  description="Vera is the async AI engineering agent that lives in Slack, Linear, and GitHub. Delegate a task in a DM, wake up to a merged pull request. No new IDE. No babysitting."
>
  <Nav />
  <main>
    <Hero />
    <HowItWorks />
    <GitHub />
    <Slack />
    <UseCases />
  </main>
  <CTAFooter />
</Layout>
