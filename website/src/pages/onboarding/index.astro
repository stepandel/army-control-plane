---
export const prerender = false;

import OnboardingLayout from "../../layouts/OnboardingLayout.astro";

const runtime = Astro.locals.runtime;
const apiBase = runtime.env.API_BASE_URL;

const cookie = Astro.request.headers.get("cookie");
if (cookie?.includes("__Host-session=")) {
  const { verifyJwt } = await import("../../lib/jwt");
  const token = cookie.match(/(?:^|;\s*)__Host-session=([^;]*)/)?.[1];
  if (token) {
    const session = await verifyJwt(token, runtime.env.SESSION_SECRET);
    if (session) return Astro.redirect("/account");
  }
}

const providers = [
  { name: "Google", href: `${apiBase}/auth/google/authorize`, className: "btn-google" },
  { name: "GitHub", href: `${apiBase}/auth/github/authorize`, className: "btn-github" },
  { name: "Discord", href: `${apiBase}/auth/discord/authorize`, className: "btn-discord" },
];
---

<OnboardingLayout title="Vera — Create Account">
  <div class="onboarding">
    <h1>Create your Vera account</h1>
    <p class="subtitle">
      Start with an account using Google, GitHub, or Discord. Workspace install and deployment will come in a later step.
    </p>

    <div class="provider-grid">
      {providers.map((provider) => (
        <a href={provider.href} class={`provider-btn ${provider.className}`}>
          Continue with {provider.name}
        </a>
      ))}
    </div>

    <div class="note-card">
      <h2>What happens next</h2>
      <p>
        Account creation now only signs you in. It does not install Slack or provision a tenant machine from this page.
      </p>
    </div>

    <p class="footer-link">
      Already have an account? <a href="/sign-in">Sign in.</a>
    </p>
  </div>
</OnboardingLayout>

<style>
  .onboarding {
    padding-top: 2rem;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: 2rem;
    opacity: 0.75;
  }

  .provider-grid {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .provider-btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 0.9rem 1rem;
    border-radius: 10px;
    font-size: 0.92rem;
    font-weight: 600;
    border: 1px solid rgba(13, 40, 24, 0.15);
    transition: transform 0.15s, opacity 0.15s, border-color 0.15s;
  }

  .provider-btn:hover {
    transform: translateY(-1px);
    opacity: 0.92;
  }

  .btn-google {
    background: #ffffff;
    color: #1f2937;
  }

  .btn-github {
    background: #111827;
    color: #f9fafb;
  }

  .btn-discord {
    background: #5865f2;
    color: #ffffff;
    border-color: #5865f2;
  }

  .note-card {
    border: 1px solid rgba(13, 40, 24, 0.15);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    background: rgba(255, 255, 255, 0.4);
  }

  h2 {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .note-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    opacity: 0.72;
  }

  .footer-link {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    opacity: 0.65;
  }

  .footer-link a {
    text-decoration: underline;
  }
</style>
