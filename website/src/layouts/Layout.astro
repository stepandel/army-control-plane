---
import Analytics from "../components/Analytics.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = "https://agent-vera.com/";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://agent-vera.com/#organization",
      name: "Vera AI",
      legalName: "Arsent LLC",
      url: "https://agent-vera.com",
      logo: {
        "@type": "ImageObject",
        url: "https://agent-vera.com/icon-192.png",
      },
      address: {
        "@type": "PostalAddress",
        addressLocality: "San Francisco",
        addressRegion: "CA",
        addressCountry: "US",
      },
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer support",
        email: "support@agent-vera.com",
      },
      description:
        "Vera is an AI engineering agent that turns feature requests into detailed specs, gets your sign-off, then ships the PR. Embedded in Slack, Linear, and GitHub. Vera is a product of Arsent LLC, a Delaware company based in San Francisco.",
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://agent-vera.com/#vera",
      name: "Vera",
      applicationCategory: "DeveloperApplication",
      applicationSubCategory: "AI Engineering Agent",
      operatingSystem: "Web, Slack, Linear, GitHub",
      description:
        "Vera turns feature requests into detailed specs, gets your sign-off, then ships the PR. Async AI engineering agent embedded in Slack, Linear, and GitHub.",
      url: "https://agent-vera.com",
      author: { "@id": "https://agent-vera.com/#organization" },
      offers: [
        {
          "@type": "Offer",
          name: "Pro Monthly",
          price: "50.00",
          priceCurrency: "USD",
          billingIncrement: "P1M",
          description:
            "Pro plan billed monthly. $50 USD/month per workspace. Includes a 3-day free trial.",
          url: "https://agent-vera.com/pricing",
        },
        {
          "@type": "Offer",
          name: "Pro Yearly",
          price: "500.00",
          priceCurrency: "USD",
          billingIncrement: "P1Y",
          description:
            "Pro plan billed yearly. $500 USD/year per workspace — save $100 vs. monthly. Includes a 3-day free trial.",
          url: "https://agent-vera.com/pricing",
        },
      ],
      featureList: [
        "Spec-first workflow — turns feature requests into detailed specs",
        "Sign-off loop — humans approve the spec before any code is written",
        "Ships what you meant, not what you wrote — clarifies intent before implementing",
        "Async AI engineering agent",
        "Slack integration — delegate tasks via DM",
        "Linear integration — assign tickets directly",
        "GitHub integration — automated pull requests",
        "5-stage engineering lifecycle (Research, Plan, Execute, Review, Triage)",
        "Codebase-aware — reads your repo before writing code",
        "BYOK — bring your own LLM API key",
        "Autonomous backlog processing",
        "Bug triage and root cause analysis",
        "Code review with structured feedback",
      ],
      softwareVersion: "1.0",
    },
    {
      "@type": "WebPage",
      "@id": "https://agent-vera.com/#webpage",
      url: "https://agent-vera.com",
      name: "Vera — Ship What You Meant, Not What You Wrote",
      description:
        "Vera turns feature requests into detailed specs, gets your sign-off, then ships the PR. Async AI engineering agent embedded in Slack, Linear, and GitHub.",
      isPartOf: {
        "@type": "WebSite",
        "@id": "https://agent-vera.com/#website",
        name: "Vera AI",
        url: "https://agent-vera.com",
      },
      about: { "@id": "https://agent-vera.com/#vera" },
      publisher: { "@id": "https://agent-vera.com/#organization" },
    },
    {
      "@type": "FAQPage",
      "@id": "https://agent-vera.com/#faq",
      mainEntity: [
        {
          "@type": "Question",
          name: "How does Vera turn a vague feature request into shipped code?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "You describe the feature in plain English in a Slack DM or Linear ticket. Vera researches your codebase, drafts a detailed spec covering scope, edge cases, and implementation approach, then shares it back for sign-off. Once you approve the spec, Vera implements it, opens a pull request, and iterates on review feedback — asynchronously, in the tools you already use. You ship what you meant, not what you wrote.",
          },
        },
        {
          "@type": "Question",
          name: "What is an AI engineering agent?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "An AI engineering agent is an autonomous AI system that performs software engineering tasks — researching codebases, planning implementations, writing code, opening pull requests, and reviewing code — without requiring a human at the keyboard. Unlike IDE copilots that assist while you type, an AI engineering agent like Vera works asynchronously on delegated tasks.",
          },
        },
        {
          "@type": "Question",
          name: "How does Vera work in Slack?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "You delegate a task to Vera via Slack DM — describe what you need in plain English. Vera researches the codebase, drafts a detailed spec, and shares it back for your sign-off. Once approved, she implements the solution and opens a pull request on GitHub. You get progress updates in the Slack thread and review the final PR when it's ready.",
          },
        },
        {
          "@type": "Question",
          name: "How is Vera different from GitHub Copilot or Cursor?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Copilot and Cursor are IDE-embedded assistants that help while you're actively coding. Vera is an async AI engineering agent — you delegate a task and walk away. Vera works independently in Slack, Linear, and GitHub, completing full engineering workflows without requiring you at the keyboard.",
          },
        },
        {
          "@type": "Question",
          name: "How is Vera different from Devin?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Devin is a standalone AI software engineer with its own workspace. Vera is embedded in the tools your team already uses — Slack, Linear, and GitHub. No new workspace to learn. No context switching. Delegate in a DM, review a PR.",
          },
        },
        {
          "@type": "Question",
          name: "Can Vera write code while I sleep?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Vera is designed for async delegation. Assign a task before you log off and Vera works through it overnight. You wake up to a pull request ready for review.",
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="AI engineering agent, async AI engineer, AI coding agent Slack, autonomous coding agent, AI agent for Slack, delegate engineering work to AI, feature spec generation, AI product specs, requirements to PR, ship what you meant, AI feature delegation, intent clarification agent"
    />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta
      property="og:title"
      content="Vera — Ship what you meant, not what you wrote"
    />
    <meta
      property="og:description"
      content="Vera turns feature requests into detailed specs, gets your sign-off, then ships the PR. Async AI engineering agent embedded in Slack, Linear, and GitHub."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://agent-vera.com/og-image.png" />
    <meta property="og:site_name" content="Vera AI" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Vera — Ship what you meant, not what you wrote"
    />
    <meta
      name="twitter:description"
      content="Vera turns feature requests into detailed specs, gets your sign-off, then ships the PR. Async AI engineering agent embedded in Slack, Linear, and GitHub."
    />
    <meta name="twitter:image" content="https://agent-vera.com/og-image.png" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,900&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
  </head>
  <body>
    <slot />
    <Analytics />
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --color-bg: #f0ede8;
        --color-text: #0d2818;
        --color-text-muted: #0d2818;
        --color-border: #0d2818;
        --max-width: 1200px;
        --font-sans: "Satoshi", -apple-system, BlinkMacSystemFont, "Segoe UI",
          Roboto, "Helvetica Neue", Arial, sans-serif;
        --font-mono: "SF Mono", "Fira Code", "Fira Mono", "Roboto Mono",
          monospace;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-sans);
        background-color: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }

      a {
        color: var(--color-text);
        text-decoration: none;
      }

      a:hover {
        opacity: 0.7;
      }

      img {
        max-width: 100%;
        height: auto;
        display: block;
      }
    </style>
  </body>
</html>
